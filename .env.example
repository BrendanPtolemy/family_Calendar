# Port the API (and, in production, the built web app) listens on
PORT=8787

# Where family data is stored (JSON file)
DATA_FILE=./data/family.json

# Budget / grocery / meal-plan integration.
#   sample = built-in demo data (default)
#   http   = your family budget app's REST API (see server/integrations/budget/http.ts)
BUDGET_PROVIDER=sample
BUDGET_API_URL=
BUDGET_API_KEY=

# How often to refresh subscribed calendar feeds (minutes)
CALENDAR_REFRESH_MINUTES=15

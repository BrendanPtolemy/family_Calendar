# Port the API (and, in production, the built web app) listens on
PORT=8787

# Where family data is stored (JSON file)
DATA_FILE=./data/family.json

# Budget / grocery / meal-plan integration.
#   sample = built-in demo data (default)
#   family_saas = the family budget app (server/integrations/budget/family-saas.ts)
BUDGET_PROVIDER=sample

# For family_saas: the family's address, e.g. https://ptolemy.saas.almagestlabs.com
# (or http://localhost:3000 with FAMILY_SAAS_TENANT set to the family's slug).
# Use a dedicated family_saas user for the wall display.
FAMILY_SAAS_URL=
FAMILY_SAAS_TENANT=
FAMILY_SAAS_USERNAME=
FAMILY_SAAS_PASSWORD=
FAMILY_SAAS_CURRENCY=USD

# How often to refresh subscribed calendar feeds (minutes)
CALENDAR_REFRESH_MINUTES=15

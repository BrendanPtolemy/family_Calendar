# Port the API (and, in production, the built web app) listens on
PORT=8787

# Where family data is stored (JSON file). Pairing codes from `npm run pair`
# are written beside it (pairing-codes.json).
DATA_FILE=./data/family.json


# Proxies whose X-Forwarded-For is trusted (comma-separated). "loopback" covers
# nginx on the same box; add the WireGuard hub if it proxies straight here,
# e.g. loopback,10.0.0.1
TRUST_PROXY=loopback

# Budget / grocery / meal-plan integration.
#   sample = built-in demo data (default)
#   http   = the family budget app (family-saas). Create the key there with
#            `node scripts/calendar-token.js --slug=<family>`.
BUDGET_PROVIDER=sample
BUDGET_API_URL=http://127.0.0.1:3010
BUDGET_TENANT=
BUDGET_API_KEY=

# How often to refresh subscribed calendar feeds (minutes)
CALENDAR_REFRESH_MINUTES=15
